---
const socials = [
  { label: "GitHub", href: "https://github.com/heykelprayogi", icon: "github" },
  { label: "LinkedIn", href: "https://linkedin.com/in/heykelprayogi", icon: "linkedin" },
  { label: "Email", href: "mailto:heykelprayogi123@gmail.com", icon: "mail" },
];

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-color)] bg-[var(--bg-secondary)] relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10"> <!-- py-8 diubah ke py-10 agar lebih lega -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4"> <!-- gap diperbesar untuk mobile -->
      
      <!-- Left: Name & tagline -->
      <div class="text-center md:text-left">
        <p class="font-bold text-[var(--text-primary)] text-lg">
          Heykel Prayogi Timanta G.s
        </p>
        <p class="text-sm text-[var(--text-muted)] mt-1">
          Software Engineer · AI & Computer Vision
        </p>
      </div>

      <!-- Center: Nav quick links -->
      <div class="flex items-center gap-5 text-sm font-medium text-[var(--text-secondary)]">
        <a href="#projects" class="hover:text-[var(--brand-primary)] transition-colors">Projects</a>
        <span class="text-[var(--border-color)]">·</span>
        <a href="#experience" class="hover:text-[var(--brand-primary)] transition-colors">Experience</a>
        <span class="text-[var(--border-color)]">·</span>
        <a href="#contact" class="hover:text-[var(--brand-primary)] transition-colors">Contact</a>
      </div>

      <!-- Right: Social icons -->
      <div class="flex items-center gap-3">
        {
          socials.map((s) => (
            <a
              href={s.href}
              target={s.icon !== "mail" ? "_blank" : undefined}
              rel={s.icon !== "mail" ? "noopener noreferrer" : undefined}
              aria-label={s.label}
              class="
                w-9 h-9 rounded-lg border border-[var(--border-color)] bg-[var(--bg-card)]
                flex items-center justify-center
                text-[var(--text-muted)] hover:text-white hover:bg-[var(--brand-primary)]
                hover:border-[var(--brand-primary)] hover:shadow-md hover:-translate-y-1
                transition-all duration-300
              "
            >
              {s.icon === "github" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
                </svg>
              )}
              {s.icon === "linkedin" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              )}
              {s.icon === "mail" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-[var(--border-color)] flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[var(--text-muted)]">
        © {currentYear} Heykel Prayogi Timanta G.s. All rights reserved.
      </p>
    </div>
  </div>
</footer>