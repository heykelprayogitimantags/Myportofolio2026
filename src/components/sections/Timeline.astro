---
import { supabase } from "../../lib/supabase";

// Fetch experiences dari Supabase
let experiences: any[] = [];
let error: string | null = null;

try {
  const { data, error: fetchError } = await supabase
    .from("experiences")
    .select("*")
    .order("display_order", { ascending: true });

  if (fetchError) throw fetchError;
  experiences = data ?? [];
} catch (e) {
  error = "Gagal memuat data. Pastikan Supabase sudah dikonfigurasi.";
  // Fallback data saat development / Supabase belum setup
  experiences = [
    {
      id: "1",
      type: "education",
      title: "D4 Software Engineering Technology",
      institution: "Politeknik / Universitas",
      location: "Indonesia",
      start_date: "2020-09-01",
      end_date: "2024-08-31",
      description: "Program D4 Teknologi Rekayasa Perangkat Lunak. Fokus pada pengembangan perangkat lunak fullstack dan riset AI/Computer Vision. Skripsi: Sistem Deteksi Fokus Siswa dengan Facial Expression Recognition.",
      tags: ["Software Engineering", "AI/ML", "Fullstack"],
    },
    {
      id: "2",
      type: "work",
      title: "Skripsi Researcher — Facial Expression Recognition",
      institution: "Laboratorium AI & Computer Vision",
      location: "Indonesia",
      start_date: "2023-09-01",
      end_date: "2024-06-30",
      description: "Penelitian mendalam di bidang computer vision. Mengembangkan FocusAI — sistem deteksi tingkat fokus siswa menggunakan MobileNetV2 + MTCNN.",
      tags: ["Deep Learning", "TensorFlow", "Computer Vision"],
    },
  ];
}

// Format tanggal
function formatDate(dateStr: string | null) {
  if (!dateStr) return "Sekarang";
  const d = new Date(dateStr);
  return d.toLocaleDateString("id-ID", { month: "short", year: "numeric" });
}

// Type colors
const typeConfig: Record<string, { label: string; color: string; dot: string }> = {
  education: { label: "Pendidikan", color: "text-blue-500 bg-blue-500/10 border-blue-500/20", dot: "#3b82f6" },
  work: { label: "Pengalaman", color: "text-green-500 bg-green-500/10 border-green-500/20", dot: "#22c55e" },
  organization: { label: "Organisasi", color: "text-purple-500 bg-purple-500/10 border-purple-500/20", dot: "#8b5cf6" },
};
---

<section id="experience" class="section-padding bg-[var(--bg-primary)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Section Header -->
    <div class="text-center mb-14">
      <span class="inline-block text-[var(--brand-primary)] text-sm font-semibold tracking-widest uppercase mb-3">
        Journey
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] mb-4">
        Pengalaman & Pendidikan
      </h2>
      <p class="text-[var(--text-secondary)] max-w-xl mx-auto">
        Perjalanan akademik dan profesional saya dalam dunia software engineering & AI.
      </p>
      <div class="w-16 h-1 rounded-full bg-gradient-to-r from-[var(--brand-primary)] to-purple-500 mx-auto mt-4"></div>
    </div>

    {error && (
      <div class="text-center text-yellow-500 text-sm mb-8 p-3 bg-yellow-500/10 rounded-lg border border-yellow-500/20">
        ⚠️ {error} — menampilkan data fallback.
      </div>
    )}

    <!-- Timeline -->
    <div class="relative">
      <!-- Center line (desktop) -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-[var(--border-color)] to-transparent -translate-x-1/2"></div>

      <!-- Timeline items -->
      <div class="space-y-8">
        {
          experiences.map((exp, idx) => {
            const config = typeConfig[exp.type] ?? typeConfig.education;
            const isLeft = idx % 2 === 0;

            return (
              <div class={`relative flex items-start gap-8 ${isLeft ? "md:flex-row" : "md:flex-row-reverse"}`}>

                <!-- Content Card -->
                <div class="flex-1 md:max-w-[calc(50%-2rem)]">
                  <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-card)] p-6 hover:border-[var(--brand-primary)]/30 hover:shadow-[var(--shadow-md)] transition-all duration-300 card-hover">

                    <!-- Type badge -->
                    <span class={`inline-block text-xs font-semibold px-2 py-0.5 rounded-full border ${config.color} mb-3`}>
                      {config.label}
                    </span>

                    <!-- Title & Institution -->
                    <h3 class="font-bold text-[var(--text-primary)] text-lg leading-snug mb-1">
                      {exp.title}
                    </h3>
                    <div class="flex flex-wrap items-center gap-2 text-sm text-[var(--text-muted)] mb-3">
                      <span class="font-medium text-[var(--text-secondary)]">{exp.institution}</span>
                      {exp.location && (
                        <>
                          <span>·</span>
                          <span>{exp.location}</span>
                        </>
                      )}
                    </div>

                    <!-- Date range -->
                    <div class="flex items-center gap-1.5 text-xs text-[var(--text-muted)] mb-3">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                        <line x1="16" x2="16" y1="2" y2="6"/>
                        <line x1="8" x2="8" y1="2" y2="6"/>
                        <line x1="3" x2="21" y1="10" y2="10"/>
                      </svg>
                      <span>{formatDate(exp.start_date)} — {formatDate(exp.end_date)}</span>
                    </div>

                    <!-- Description -->
                    {exp.description && (
                      <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
                        {exp.description}
                      </p>
                    )}

                    <!-- Tags -->
                    {exp.tags && exp.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5">
                        {exp.tags.map((tag: string) => (
                          <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--bg-tertiary)] text-[var(--text-muted)] border border-[var(--border-color)]">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>

                <!-- Center Dot (desktop) -->
                <div class="hidden md:flex absolute left-1/2 top-6 -translate-x-1/2 w-4 h-4 rounded-full border-2 border-[var(--bg-primary)] items-center justify-center z-10"
                  style={`background: ${config.dot}; box-shadow: 0 0 0 4px ${config.dot}20;`}>
                </div>

                <!-- Left dot (mobile) -->
                <div class="md:hidden flex-shrink-0 w-3 h-3 rounded-full mt-6 border-2 border-[var(--bg-primary)]"
                  style={`background: ${config.dot};`}>
                </div>

                <!-- Empty spacer for alternating layout -->
                <div class="hidden md:block flex-1"></div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
