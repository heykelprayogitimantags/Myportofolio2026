---
// Tech Stack Section — Full Adaptive Light & Dark Theme
const techCategories = [
  {
    category: "Frontend Engineering",
    description: "Merancang antarmuka web yang responsif, cepat, interaktif, dan terstruktur.",
    skills: [
      { name: "Astro", tag: "SSG / Framework" },
      { name: "React", tag: "UI Library" },
      { name: "Next.js", tag: "Fullstack Framework" },
      { name: "TypeScript", tag: "Language" },
      { name: "Tailwind CSS", tag: "Styling" },
      { name: "HTML5 / CSS3", tag: "Core Web" },
    ],
  },
  {
    category: "Backend & Systems",
    description: "Arsitektur REST API, logic server, manipulasi data, dan integrasi microservices.",
    skills: [
      { name: "Python", tag: "Core Language" },
      { name: "Node.js", tag: "Runtime" },
      { name: "FastAPI / Flask", tag: "REST APIs" },
      { name: "Express.js", tag: "Framework" },
      { name: "Zod / Schema", tag: "Validation" },
    ],
  },
  {
    category: "Database & Infrastructure",
    description: "Pemodelan basis data, cloud deployment, dan otomatisasi workflow CI/CD.",
    skills: [
      { name: "PostgreSQL", tag: "Relational DB" },
      { name: "MySQL / SQLite", tag: "Database" },
      { name: "Supabase", tag: "BaaS & Auth" },
      { name: "Docker", tag: "Containerization" },
      { name: "Vercel / Cloud", tag: "Deployment" },
      { name: "Git & GitHub", tag: "VCS Workflow" },
    ],
  },
  {
    category: "AI & Computer Vision",
    description: "Pengembangan model deep learning, computer vision, dan pipeline analisis data.",
    skills: [
      { name: "PyTorch / TensorFlow", tag: "Deep Learning" },
      { name: "OpenCV", tag: "Computer Vision" },
      { name: "YOLOv8 / MobileNet", tag: "Object & Face AI" },
      { name: "scikit-learn", tag: "Machine Learning" },
      { name: "Pandas / NumPy", tag: "Data Analytics" },
    ],
  },
];
---

<section id="tech-stack" class="pt-32 pb-24 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300 relative overflow-hidden">
  
  <!-- Ambient Glow Background -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute top-1/3 -left-32 w-96 h-96 bg-blue-400/20 dark:bg-blue-600/15 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-10 -right-32 w-96 h-96 bg-indigo-400/20 dark:bg-indigo-600/15 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/30 dark:border-blue-500/20 bg-blue-500/10 dark:bg-blue-500/10 text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 mb-4">
        <span>// CAPABILITIES & TOOLING</span>
      </div>
      
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
        Tech Stack & Expertise
      </h2>
      
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed">
        Bahasa pemrograman, framework, dan ekosistem teknologi yang saya gunakan untuk membangun sistem perangkat lunak yang andal dan scalable.
      </p>
    </div>

    <!-- Tech Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        techCategories.map((cat, idx) => (
          <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 backdrop-blur-xl p-6 sm:p-8 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:border-blue-500/50 dark:hover:border-blue-400/50 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <!-- Category Header -->
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  {cat.category}
                </h3>
                <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700/80">
                  0{idx + 1}
                </span>
              </div>
              
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">
                {cat.description}
              </p>

              <!-- Skill Badges -->
              <div class="flex flex-wrap gap-2.5">
                {cat.skills.map((skill) => (
                  <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100/80 dark:bg-slate-950/70 hover:bg-white dark:hover:bg-slate-800/90 hover:border-blue-500/40 dark:hover:border-blue-400/40 transition-all duration-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 dark:bg-blue-400"></span>
                    <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">{skill.name}</span>
                    <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono border-l border-slate-300 dark:border-slate-800 pl-2">
                      {skill.tag}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Architecture Note -->
    <div class="mt-12 p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 backdrop-blur-md text-center max-w-2xl mx-auto shadow-sm">
      <p class="text-xs text-slate-600 dark:text-slate-400 font-mono flex items-center justify-center gap-2">
        <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
        Berfokus pada arsitektur modular, performa tinggi, dan integrasi AI ke dalam ekosistem web modern.
      </p>
    </div>

  </div>
</section>