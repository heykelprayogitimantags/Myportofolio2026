---
// Tech Stack Section — 4 kategori: Frontend, Backend, Database, AI/ML Tools

const techCategories = [
  {
    category: "Frontend",
    icon: "🎨",
    color: "from-blue-500/10 to-cyan-500/10 border-blue-500/20",
    accent: "#3b82f6",
    skills: [
      { name: "Astro", level: 4 },
      { name: "React", level: 4 },
      { name: "TypeScript", level: 4 },
      { name: "Tailwind CSS", level: 5 },
      { name: "HTML/CSS", level: 5 },
      { name: "Framer Motion", level: 3 },
      { name: "JavaScript", level: 4 },
    ],
  },
  {
    category: "Backend",
    icon: "⚙️",
    color: "from-green-500/10 to-emerald-500/10 border-green-500/20",
    accent: "#22c55e",
    skills: [
      { name: "Python", level: 5 },
      { name: "Flask", level: 4 },
      { name: "Node.js", level: 3 },
      { name: "REST API", level: 4 },
      { name: "Zod", level: 4 },
    ],
  },
  {
    category: "Database & Cloud",
    icon: "🗄️",
    color: "from-purple-500/10 to-violet-500/10 border-purple-500/20",
    accent: "#8b5cf6",
    skills: [
      { name: "Supabase", level: 4 },
      { name: "PostgreSQL", level: 4 },
      { name: "SQLite", level: 4 },
      { name: "Vercel", level: 4 },
      { name: "Git & GitHub", level: 4 },
    ],
  },
  {
    category: "AI / ML Tools",
    icon: "🧠",
    color: "from-orange-500/10 to-red-500/10 border-orange-500/20",
    accent: "#f97316",
    skills: [
      { name: "TensorFlow", level: 4 },
      { name: "Keras", level: 4 },
      { name: "OpenCV", level: 4 },
      { name: "MobileNetV2", level: 4 },
      { name: "MTCNN", level: 4 },
      { name: "scikit-learn", level: 3 },
      { name: "NumPy / Pandas", level: 4 },
      { name: "Jupyter", level: 4 },
    ],
  },
];

// Level dot helper: 1–5
const levelLabels = ["", "Beginner", "Basic", "Intermediate", "Advanced", "Expert"];
---

<section id="tech-stack" class="section-padding bg-[var(--bg-secondary)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Section Header -->
    <div class="text-center mb-14">
      <span class="inline-block text-[var(--brand-primary)] text-sm font-semibold tracking-widest uppercase mb-3">
        Skills & Technologies
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] mb-4">
        Tech Stack
      </h2>
      <p class="text-[var(--text-secondary)] max-w-xl mx-auto">
        Teknologi yang saya kuasai — dengan <strong class="text-[var(--text-primary)]">AI/ML Tools</strong> sebagai spesialisasi utama.
      </p>
      <div class="w-16 h-1 rounded-full bg-gradient-to-r from-[var(--brand-primary)] to-purple-500 mx-auto mt-4"></div>
    </div>

    <!-- Tech Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        techCategories.map((cat) => (
          <div
            class={`rounded-2xl border bg-gradient-to-br ${cat.color} bg-[var(--bg-card)] p-6 hover:shadow-[var(--shadow-glow)] transition-all duration-300 card-hover`}
            style={`--accent: ${cat.accent};`}
          >
            <!-- Card Header -->
            <div class="flex items-center gap-3 mb-5">
              <span class="text-2xl">{cat.icon}</span>
              <h3 class="font-bold text-[var(--text-primary)] text-lg">{cat.category}</h3>
            </div>

            <!-- Skills List -->
            <div class="space-y-3">
              {
                cat.skills.map((skill) => (
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-sm font-medium text-[var(--text-primary)] min-w-0 truncate">
                      {skill.name}
                    </span>
                    <!-- Level dots -->
                    <div class="flex items-center gap-1 flex-shrink-0" title={levelLabels[skill.level]}>
                      {[1, 2, 3, 4, 5].map((dot) => (
                        <div
                          class="w-2 h-2 rounded-full transition-all duration-200"
                          style={
                            dot <= skill.level
                              ? `background: ${cat.accent}; box-shadow: 0 0 4px ${cat.accent}40;`
                              : "background: var(--border-color);"
                          }
                        />
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bottom Note -->
    <p class="text-center text-xs text-[var(--text-muted)] mt-8">
      ⚡ Level: 1 Beginner → 5 Expert &nbsp;|&nbsp; Selalu belajar teknologi baru
    </p>
  </div>
</section>
