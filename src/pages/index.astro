---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import TechStack from "../components/sections/TechStack.astro";
import Projects from "../components/sections/Projects";
import Timeline from "../components/sections/Timeline.astro";
import Certificates from "../components/sections/Certificates";
import Contact from "../components/sections/Contact";
import Guestbook from "../components/sections/Guestbook";
import Preloader from "../components/Preloader";
import ScrollToTop from "../components/ScrollToTop.astro"; // <-- Tambahkan import ini
import { supabase, isSupabaseConfigured } from "../lib/supabase";

// SSR: Fetch projects & certificates dari Supabase saat server render
let initialProjects: any[] = [];
let initialCertificates: any[] = [];

if (isSupabaseConfigured) {
  try {
    const [projectsRes, certsRes] = await Promise.all([
      supabase.from("projects").select("*").order("display_order", { ascending: true }),
      supabase.from("certificates").select("*").order("display_order", { ascending: true }),
    ]);
    if (!projectsRes.error) initialProjects = projectsRes.data ?? [];
    if (!certsRes.error) initialCertificates = certsRes.data ?? [];
  } catch (e) {
    console.warn("[index] Supabase fetch failed:", e);
  }
}
---

<BaseLayout
  title="portofolio-heykel"
  description="Portofolio Heykel Prayogi, Software Engineer spesialisasi AI & Computer Vision. Membangun aplikasi fullstack dengan machine learning dan facial recognition."
>
  <!-- Preloader animasi dimuat pertama kali saat halaman dibuka -->
  <Preloader client:load />

  <Navbar />
  <main>
    <Hero />
    <TechStack />
    <Projects client:visible initialProjects={initialProjects} />
    <Timeline />
    <Certificates client:visible initialCertificates={initialCertificates} />
    <Contact client:visible />
    <Guestbook client:visible />
  </main>
  <Footer />
  
  <!-- Tombol Scroll ke Atas diletakkan di luar main agar melayang bebas -->
  <ScrollToTop />
</BaseLayout>